# ── Django Core Settings ──────────────────────────────────────────────
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database Configurations ───────────────────────────────────────────
# To use SQLite (e.g. for local development), comment out the DB_* lines below.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# ── Directory Configurations (Safe Outside-Backend Storage) ──────────
# Set these on cPanel/Production to folders outside the backend/ directory.
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=

# ── Email (required for "Forgot Password" to actually send mail) ──────
# Without these, emails just print to the console — fine for local dev,
# but password reset links will never reach real users in production.
# Use the SMTP details for the mailbox you want to send from (e.g. the
# cPanel mail account for info@successfulluxurysafaris.co.ke).
DJANGO_EMAIL_HOST=mail.successfulluxurysafaris.co.ke
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=info@successfulluxurysafaris.co.ke
DJANGO_EMAIL_HOST_PASSWORD=your-mailbox-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=info@successfulluxurysafaris.co.ke

# ── Administrative Credentials (Optional helper vars) ─────────────────
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change_this_password
